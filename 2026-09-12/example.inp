! 第2课：燃料芯块—气隙—包壳稳态径向导热（SI单位）
/CLEAR
/FILNAME,fuel_rod_radial,1
/PREP7
! m, kg, s, K, W, Pa
RPEL=4.00E-3
RGAP=4.08E-3
RCLD=4.65E-3
LSEG=1.00E-2
QGEN=3.00E8
KUEL=3.0
KGAP=0.30
KCLD=16.0
HCOOL=2.00E4
TBULK=580
ESIZE_R=1.0E-4

ET,1,PLANE55
KEYOPT,1,3,1
MP,KXX,1,KUEL
MP,KXX,2,KGAP
MP,KXX,3,KCLD

RECTNG,0,RPEL,0,LSEG
RECTNG,RPEL,RGAP,0,LSEG
RECTNG,RGAP,RCLD,0,LSEG
AGLUE,ALL

ASEL,S,CENT,X,0,RPEL
AATT,1,,1
ASEL,S,CENT,X,RPEL,RGAP
AATT,2,,1
ASEL,S,CENT,X,RGAP,RCLD
AATT,3,,1
ALLSEL,ALL
ESIZE,ESIZE_R
AMESH,ALL

! 体积热源只施加于燃料芯块
ESEL,S,MAT,,1
BFE,ALL,HGEN,,QGEN
ALLSEL,ALL

! 包壳外表面对流
LSEL,S,LOC,X,RCLD
SFL,ALL,CONV,HCOOL,TBULK
ALLSEL,ALL
FINISH

/SOLU
ANTYPE,STATIC
SOLVE
FINISH

/POST1
SET,LAST
PLNSOL,TEMP
*GET,TMAX,NODE,0,MAX,TEMP
*GET,TMIN,NODE,0,MIN,TEMP
*CFOPEN,radial_results,txt
*VWRITE,TMAX,TMIN
('TMAX_K=',E16.8,', TMIN_K=',E16.8)
*CFCLOS
FINISH
