/CLEAR,NOSTART                 ! 清空独立教学模型；不会连接用户已运行的求解实例
/FILNAME,lesson20              ! 输出文件前缀；单位为m、N、kg、s、Hz、Pa
length0=0.50                   ! 等效控制棒梁长度m；不是真实组件尺寸
side0=0.020                    ! 正方形等效截面边长m；不是真实复合截面
nelem=40                       ! 沿轴向单元数；网格检查可改为80
emod0=1.90e11                  ! 弹性模量Pa；教学常数
rho0=7800                      ! 密度kg/m^3；教学常数
nu0=0.30                       ! 泊松比；无量纲
force0=10                      ! 中点横向简谐力幅值N；流致载荷的等效教学输入
zeta0=0.02                     ! 常数结构阻尼比；教学假定，非实测阻尼
fmin0=20                       ! 频率扫掠下限Hz
fmax0=300                      ! 频率扫掠上限Hz
nfrq0=141                      ! 扫频解数；名义间隔2 Hz
area0=side0**2                 ! 等效截面积m^2
iner0=side0**4/12              ! 绕Z弯曲的截面二次矩m^4
pi0=ACOS(-1)                   ! 圆周率
feb0=pi0/(2*length0**2)*SQRT(emod0*iner0/(rho0*area0)) ! 理想铰支Euler-Bernoulli一阶频率Hz，仅供对照
/PREP7                         ! 建立三维梁的面内弯曲模型
ET,1,BEAM188                   ! 三维梁单元，包含剪切与转动惯性
KEYOPT,1,3,3                   ! 采用三次插值
SECTYPE,1,BEAM,RECT            ! 矩形等效截面类型
SECDATA,side0,side0            ! 截面宽度与高度m
MP,EX,1,emod0                  ! 材料弹性模量Pa
MP,PRXY,1,nu0                  ! 材料泊松比
MP,DENS,1,rho0                 ! 惯性质量所需密度kg/m^3
*DO,ii,0,nelem                 ! 沿X轴生成节点
N,ii+1,length0*ii/nelem,0,0   ! 节点坐标m
*ENDDO                         ! 结束节点循环
*DO,ii,1,nelem                 ! 连续连接梁单元
E,ii,ii+1                     ! 生成当前梁单元
*ENDDO                         ! 结束单元循环
D,ALL,UZ,0                     ! 抑制出平面平动
D,ALL,ROTX,0                   ! 抑制扭转
D,ALL,ROTY,0                   ! 抑制出平面弯曲转角
D,1,UY,0                       ! 左端横向铰支
D,nelem+1,UY,0                 ! 右端横向铰支
D,1,UX,0                       ! 左端限制轴向刚体位移；右端轴向自由
midnode=nelem/2+1              ! 40单元时为中点节点21
F,midnode,FY,force0            ! 中点施加横向谐波载荷的实部幅值N
FINISH                         ! 完成前处理
/SOLU                          ! 进入求解器
ANTYPE,HARMIC                  ! 执行线性频域谐响应
HROPT,FULL                     ! 全矩阵法；未做降阶
DMPRAT,zeta0                   ! 假定常数结构阻尼比
HARFRQ,fmin0,fmax0             ! 指定20–300 Hz扫掠范围
NSUBST,nfrq0                   ! 指定141个求解频率点
OUTRES,NSOL,ALL                ! 保存频点节点位移以备后处理
SOLVE                          ! 求解谐波稳态响应
FINISH                         ! 结束求解
/POST26                        ! 读取频率—位移历史
NSOL,2,midnode,U,Y,UY_MID      ! 变量2为中点Y向复位移，单位m
PRCPLX,1                       ! 将复位移列表转成幅值与相位
PRVAR,2                        ! 在求解输出中列表显示各频点中点位移
FINISH                         ! 结束教学案例
