! 第18课：控制棒—导向管局部平面应变摩擦接触；SI单位 m、Pa、N
/CLEAR,NOSTART                  ! 清空独立教学数据库
/FILNAME,lesson18_contact       ! 设置独立求解文件名前缀
len0=0.020                      ! 局部接触块沿滑移方向长度，单位 m
thick0=0.005                    ! 局部接触块厚度，单位 m
gap0=1.0e-4                    ! 初始法向间隙，单位 m
indent0=1.0e-6                 ! 间隙闭合后压入量，单位 m，教学值
slide0=2.0e-3                  ! 第二载荷步切向位移，单位 m
mu0=0.20                       ! 库仑摩擦系数，教学常数
/PREP7                          ! 进入前处理器
ET,1,PLANE183                   ! 定义二维高阶结构单元
KEYOPT,1,3,2                    ! 设置平面应变，结果按单位出平面厚度解释
MP,EX,1,1.9e11                  ! 教学弹性模量，单位 Pa
MP,PRXY,1,0.30                  ! 泊松比，无量纲
RECTNG,0,len0,gap0,gap0+thick0  ! 创建控制棒局部弹性接触块
AATT,1,,1                       ! 为面积指定材料1和单元1
ESIZE,0.5e-3                    ! 目标网格尺寸，单位 m
AMESH,ALL                       ! 对局部接触块网格化
NSEL,S,LOC,Y,gap0+thick0        ! 选择加载顶边节点
CM,TOPLOAD,NODE                 ! 保存顶边加载节点组件
ALLSEL,ALL                      ! 恢复所有选择
ET,2,TARGE169                   ! 定义二维刚性导向管局部目标面
KEYOPT,2,2,1                    ! 显式指定目标节点边界条件
ET,3,CONTA172                   ! 定义二维面面摩擦接触单元
KEYOPT,3,2,0                    ! 使用增广拉格朗日接触算法
KEYOPT,3,5,0                    ! 保留初始间隙，不自动贴合
KEYOPT,3,12,0                   ! 标准可分离摩擦接触
MP,MU,2,mu0                     ! 接触材料2的库仑摩擦系数
R,1,,,1.0,0.1                   ! 默认半径为空；法向刚度因子1、穿透容差因子0.1
TYPE,2                         ! 激活目标面单元类型
REAL,1                         ! 目标面和接触面共用实常数集1
N,100001,len0+0.010,0            ! 定义右侧目标节点，单位 m
N,100002,-0.010,0                ! 定义左侧目标节点，单位 m
TSHAP,LINE                      ! 指定目标面为直线段
E,100001,100002                 ! 右到左排列，使接触块位于有向目标线右侧
D,100001,UX,0                   ! 固定刚性目标右节点切向自由度
D,100001,UY,0                   ! 固定刚性目标右节点法向自由度
D,100002,UX,0                   ! 固定刚性目标左节点切向自由度
D,100002,UY,0                   ! 固定刚性目标左节点法向自由度
NSEL,S,LOC,Y,gap0               ! 选择接触块底边节点
TYPE,3                         ! 激活CONTA172接触单元
MAT,2                          ! 给接触面指定摩擦材料2
REAL,1                         ! 关联刚性目标面的实常数集
ESURF                          ! 在所选实体底边生成接触单元
ALLSEL,ALL                      ! 恢复所有实体选择
FINISH                          ! 结束前处理
/SOLU                           ! 进入结构静力求解器
ANTYPE,STATIC                   ! 指定静力分析
NLGEOM,ON                      ! 考虑滑移几何非线性
NROPT,FULL                     ! 使用完整Newton迭代
AUTOTS,ON                      ! 启用自动载荷子步
NSUBST,40,200,10                ! 初始40子步、最大200、最小10
OUTRES,ALL,ALL                  ! 保存所有子步结果供接触路径核验
CMSEL,S,TOPLOAD                 ! 只选择接触块顶边加载节点
D,ALL,UX,0                     ! 预压步保持切向位移为零
D,ALL,UY,-gap0-indent0         ! 先闭合初始间隙，再施加教学压入量
ALLSEL,ALL                      ! 恢复全模型选择
TIME,1                         ! 第一载荷步结束时间为1，静力伪时间
SOLVE                          ! 求解法向预压，避免直接跳至滑动状态
CMSEL,S,TOPLOAD                 ! 再选择顶边加载节点
D,ALL,UX,slide0                ! 在保持法向预压下施加切向位移
ALLSEL,ALL                      ! 恢复全模型选择
TIME,2                         ! 第二载荷步结束伪时间为2
SOLVE                          ! 求解预压后的摩擦滑动
FINISH                          ! 结束求解器
/POST1                          ! 进入结果后处理器
SET,LAST                        ! 读取最终滑移结果
CMSEL,S,TOPLOAD                 ! 选择加载顶边以汇总反力
PRRSOL                          ! 列出全部约束反力，单位厚度下等效N/m
*GET,ntop,NODE,0,COUNT          ! 获得加载顶边节点数
*GET,ncur,NODE,0,NUM,MIN        ! 获得首个加载顶边节点编号
rfx=0                          ! 初始化切向反力合计
rfy=0                          ! 初始化法向反力合计
*DO,ii,1,ntop,1                 ! 遍历顶边每一个约束节点
  *GET,rx,NODE,ncur,RF,FX        ! 提取本节点切向约束反力
  *GET,ry,NODE,ncur,RF,FY        ! 提取本节点法向约束反力
  rfx=rfx+rx                   ! 累加切向反力
  rfy=rfy+ry                   ! 累加法向反力
  ncur=NDNEXT(ncur)             ! 移至选择集内的下一节点
*ENDDO                          ! 完成反力汇总
ALLSEL,ALL                      ! 恢复全模型选择
ratio=ABS(rfx/rfy)              ! 最终切向与法向反力比；法向反力应非零
*CFOPEN,lesson18_reactions,csv   ! 打开独立反力汇总文件
*VWRITE                         ! 写CSV列名；下一行为纯格式行
('Fx_per_width,Fy_per_width,abs_Fx_over_Fy,mu')
*VWRITE,rfx,rfy,ratio,mu0        ! 写最终反力与摩擦系数；下一行为纯格式行
(E18.10,',',E18.10,',',E18.10,',',E18.10)
*CFCLOS                         ! 关闭CSV文件
ESEL,S,TYPE,,3                  ! 只选接触单元查看接触状态与压力
PRESOL,CONT                     ! 打印接触结果以核验接触/滑动状态
ALLSEL,ALL                      ! 恢复全模型选择
FINISH                          ! 结束后处理
