/CLEAR,NOSTART                 ! 清空教学数据库，不连接用户正在运行的求解实例
/FILNAME,lesson19              ! 定义本例文件名；采用m、N、kg、s、℃单位制
len0=0.50                     ! 梁长m；简化控制棒组件，仅为教学几何
side0=0.020                   ! 正方形等效截面边长m；非实际控制棒截面
nelem=40                      ! 沿长度单元数，细网格对照改为80
emod=1.9e11                   ! 弹性模量Pa，本例不含温度相关材料退化
rho0=7800                     ! 密度kg/m^3
alpha0=1.2e-5                 ! 线膨胀系数1/℃
tref0=20                      ! 无应力参考温度℃
dtemp0=20                     ! 热态均匀升温℃；本例受轴向约束而受压
area0=side0**2                ! 等效截面面积m^2
iner0=side0**4/12              ! 截面二次矩m^4
pi0=ACOS(-1)                  ! 定义圆周率
pcr0=pi0**2*emod*iner0/len0**2 ! 理想铰支Euler临界力N；只作为解析对照
fref0=pi0/(2*len0**2)*SQRT(emod*iner0/(rho0*area0)) ! Euler-Bernoulli冷态一阶频率Hz
pth0=emod*area0*alpha0*dtemp0  ! 完全轴向受限时理论热压缩力N
/PREP7                       ! 前处理
ET,1,BEAM188                 ! 三维Timoshenko梁；本例约束出平面自由度
KEYOPT,1,3,3                 ! 三次插值以提高梁内位移表示
SECTYPE,1,BEAM,RECT           ! 定义矩形等效截面
SECDATA,side0,side0           ! 截面宽和高m
MP,EX,1,emod                 ! 弹性模量Pa
MP,PRXY,1,0.30               ! 泊松比
MP,DENS,1,rho0               ! 模态质量所需密度kg/m^3
MP,ALPX,1,alpha0             ! 热膨胀系数
TREF,tref0                   ! 参考温度；热应变alpha*(T-TREF)
*DO,i0,0,nelem               ! 生成沿X轴均匀节点
N,i0+1,len0*i0/nelem,0,0      ! 梁节点坐标m
*ENDDO                       ! 结束节点循环
*DO,i0,1,nelem               ! 生成连续梁单元
E,i0,i0+1                    ! 自动使用已定义材料、单元和截面
*ENDDO                       ! 结束单元循环
D,ALL,UZ,0                   ! 抑制出平面位移，只研究XY面内弯曲
D,ALL,ROTX,0                 ! 抑制扭转
D,ALL,ROTY,0                 ! 抑制出平面弯曲转角；ROTZ保持自由
D,1,UY,0                     ! 左端横向铰支
D,nelem+1,UY,0               ! 右端横向铰支
D,1,UX,0                     ! 左端轴向约束
D,nelem+1,UX,0               ! 右端轴向约束，产生热压缩预应力
FINISH                       ! 结束前处理
*CFOPEN,lesson19_results,csv  ! 打开结果CSV；下两行纯格式行不可加注释
*VWRITE                      ! 写入CSV表头
('case,T_C,Rx_left_N,f1_Hz,f2_Hz,f3_Hz,EB_f1_Hz,EB_Pcr_N')
*DO,case0,1,2                ! 冷态及热态两种独立静力基态
/SOLU                        ! 静力预应力求解
ANTYPE,STATIC,NEW            ! 新静力分析，保留同一网格与边界
PSTRES,ON                    ! 生成后续模态所需的应力刚度
NLGEOM,OFF                   ! 线性基态；不得用来研究屈曲后大变形
temp0=tref0+(case0-1)*dtemp0  ! 冷态20℃，热态40℃
BF,ALL,TEMP,temp0            ! 给所有节点施加均匀温度℃
OUTRES,ALL,ALL               ! 保存静力结果供核对
SOLVE                        ! 求解本工况静力基态
FINISH                       ! 退出求解
/POST1                       ! 检查轴向反力
SET,LAST                     ! 读取本工况静力结果
*GET,rx0,NODE,1,RF,FX        ! 提取左端轴向反力N
PRRSOL,F                     ! 打印支座力用于载荷平衡检查
FINISH                       ! 结束静力后处理
/SOLU                        ! 进入模态求解
ANTYPE,MODAL                 ! 在静力基态上提取线性模态
PSTRES,ON                    ! 将应力刚度纳入模态分析
MODOPT,LANB,3                ! Block Lanczos提取三阶面内模态
MXPAND,3,,,YES               ! 展开三阶模态并保存单元结果
SOLVE                        ! 求解预应力模态
*GET,f10,MODE,1,FREQ         ! 第一阶频率Hz
*GET,f20,MODE,2,FREQ         ! 第二阶频率Hz
*GET,f30,MODE,3,FREQ         ! 第三阶频率Hz
*VWRITE,case0,temp0,rx0,f10,f20,f30,fref0,pcr0 ! 写数据；紧邻下行保留纯FORTRAN格式
(8(E19.10,:,','))
FINISH                       ! 保留同一模型以计算下一工况
*ENDDO                       ! 结束工况循环
*CFCLOS                      ! 关闭CSV文件
/POST1                       ! 读取最终热态第一阶振型
SET,1,1                      ! 第一阶模态结果
PLDISP,2                     ! 显示面内振型；振型幅值不是实际响应位移
FINISH                       ! 结束教学分析
